# --- PostgreSQL ---
# Host for running backend/alembic on the host machine; compose overrides it with "postgres".
POSTGRES_HOST=localhost
POSTGRES_USER=catalog
POSTGRES_PASSWORD=change-me
POSTGRES_DB=catalog
POSTGRES_PORT=5432

# --- MinIO ---
MINIO_ROOT_USER=minioadmin
# at least 8 characters
MINIO_ROOT_PASSWORD=change-me-please
MINIO_BUCKET=product-images
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

# S3 endpoint for running backend on the host; compose overrides it with http://minio:9000.
MINIO_ENDPOINT_URL=http://localhost:9000

# --- Backend ---
# Public prefix for images; image_url = MEDIA_BASE_URL + "/" + image_key.
# Caddy serves /media/* read-only from $MINIO_BUCKET.
MEDIA_BASE_URL=http://localhost:8080/media
# Shared secret the bot sends in X-Internal-Token (min 16 chars): openssl rand -hex 32
INTERNAL_TOKEN=change-me-to-a-long-random-string
# Max uploaded image size in bytes (10 MiB).
MAX_IMAGE_BYTES=10485760

# --- Caddy ---
# Host port of the single entry point (/api/*, /media/*).
CADDY_HTTP_PORT=8080

# --- Bot ---
# From @BotFather.
BOT_TOKEN=123456789:change-me
# Telegram echoes it in X-Telegram-Bot-Api-Secret-Token; [A-Za-z0-9_-]{1,256}: openssl rand -hex 32
WEBHOOK_SECRET=change-me-webhook-secret
# Comma-separated Telegram user ids allowed to create products (e.g. from @userinfobot).
ADMIN_IDS=123456789
# Public HTTPS origin of Caddy; bot-setup registers PUBLIC_BASE_URL/tg/webhook.
# Telegram accepts only ports 443, 80, 88, 8443. Locally use a tunnel to CADDY_HTTP_PORT,
# e.g. `cloudflared tunnel --url http://localhost:8080`.
PUBLIC_BASE_URL=https://example.trycloudflare.com
# Mini App (catalog) URL; must be HTTPS.
WEBAPP_URL=https://example.trycloudflare.com/
# Backend base URL; compose sets http://caddy/api. For running the bot on the host:
# BACKEND_URL=http://localhost:8080/api
# Backend request timeout in seconds (keep well below aiogram's 55 s webhook budget).
# BACKEND_TIMEOUT=15
