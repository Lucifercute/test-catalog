# Single entry point. Routes live in the `app` snippet, served by two sites:
# - {$SITE_ADDRESS}: the public one. Locally ":80" (plain HTTP, any host); on the server the domain,
#   so Caddy turns on automatic HTTPS (Let's Encrypt, certs in the caddy_data volume) and redirects 80 -> 443.
# - :8081: internal, never published. bot/frontend reach the backend via http://caddy:8081/api and the
#   healthcheck hits it: with a domain site, Host "caddy"/"127.0.0.1" wouldn't match and would get redirected.
(app) {
	handle /healthz {
		respond "OK" 200
	}

	# /api/foo -> backend /foo. Every A record of the `backend` service (one per replica)
	# becomes its own upstream, so round_robin really alternates replicas; no sticky sessions.
	# Active health checks don't run for dynamic upstreams: passive checks + retries skip a dead one.
	handle_path /api/* {
		reverse_proxy {
			dynamic a backend 8000 {
				refresh 5s
			}
			lb_policy round_robin
			lb_retries 2
			fail_duration 10s
		}
	}

	# /media/products/1/1.jpg -> MinIO /<bucket>/products/1/1.jpg, read-only.
	# `route` keeps the order as written (respond before rewrite).
	handle_path /media/* {
		route {
			@write not method GET HEAD
			header @write Allow "GET, HEAD"
			respond @write 405

			# Bucket root = ListBucket (minio-init's "download" policy allows it): don't expose it.
			respond / 404

			# Trailing "?" clears the query string: no S3 sub-resources (?acl, ?uploads...) via the proxy.
			rewrite * /{$MINIO_BUCKET}{path}?
			reverse_proxy minio:9000 {
				header_up -Authorization
				header_up -Cookie
			}
		}
	}

	# Telegram webhook -> bot replicas, same balancing as /api. Path is kept as is.
	# POST only; the bot itself checks X-Telegram-Bot-Api-Secret-Token.
	# Caddy retries a POST only on dial errors, so an update is never processed twice by a retry.
	handle /tg/webhook {
		route {
			@notpost not method POST
			header @notpost Allow "POST"
			respond @notpost 405

			reverse_proxy {
				dynamic a bot 8080 {
					refresh 5s
				}
				lb_policy round_robin
				lb_retries 2
				fail_duration 10s
			}
		}
	}

	# Everything else -> frontend (Next.js) replicas, same balancing as /api.
	# Both replicas run one image, so /_next/static/* hashes match and no sticky sessions are needed.
	handle {
		reverse_proxy {
			dynamic a frontend 3000 {
				refresh 5s
			}
			lb_policy round_robin
			lb_retries 2
			fail_duration 10s
		}
	}
}

{$SITE_ADDRESS} {
	import app
}

:8081 {
	import app
}
